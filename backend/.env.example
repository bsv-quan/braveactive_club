# Copy to backend/.env and adjust. Never commit the real .env file.
ENVIRONMENT=development

# PostgreSQL (docker compose up -d db)
DATABASE_URL=postgresql+asyncpg://braveactive:braveactive@localhost:5432/braveactive

# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=dev-only-insecure-secret-change-me

# Comma separated list of allowed browser origins (CORS, Origin check, WebSocket)
FRONTEND_ORIGINS=http://localhost:3000
FRONTEND_BASE_URL=http://localhost:3000
COOKIE_SECURE=false
# Set true only when running behind a trusted reverse proxy (the Next.js proxy counts)
TRUST_PROXY_HEADERS=true
# Accounts registered with these emails become admins (comma separated)
ADMIN_EMAILS=

# Secret for GET /api/cron/activity-recurrences (optional external scheduler)
CRON_SECRET=

# Mail: leave empty to log emails to the console. For Gmail use an App Password:
# SMTP_HOST=smtp.gmail.com  SMTP_PORT=587  SMTP_USER=you@gmail.com  SMTP_PASSWORD=xxxxxxxxxxxxxxxx
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_USE_STARTTLS=true
MAIL_FROM=

UPLOAD_DIR=uploads
MAX_UPLOAD_MB=5
