# Copy to .env for local Docker Compose. These defaults are not for production.
ENVIRONMENT=development
SECRET_KEY=local-dev-secret-change-this-before-production-123456
FRONTEND_ORIGINS=http://localhost:3000
FRONTEND_BASE_URL=http://localhost:3000
COOKIE_SECURE=false
TRUST_PROXY_HEADERS=false

# Comma-separated full addresses; accounts registered after this setting is applied
# receive the admin role.
ADMIN_EMAILS=

# Gmail SMTP: use an app password, not the account password.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_USE_STARTTLS=true
MAIL_FROM=

CRON_SECRET=
MAX_UPLOAD_MB=5
