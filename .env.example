# Copy to .env; this file is sourced by scripts/run.sh. Quote shell-special characters.
RUN_MODE=development
ENVIRONMENT=development
DATABASE_URL=postgresql+asyncpg://localhost:5432/braveactive
SECRET_KEY=local-dev-secret-change-this-before-production-123456
FRONTEND_ORIGINS=http://localhost:3000
FRONTEND_BASE_URL=http://localhost:3000
COOKIE_SECURE=false
TRUST_PROXY_HEADERS=false
FRONTEND_HOST=127.0.0.1
FRONTEND_PORT=3000
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8000
BACKEND_URL=http://127.0.0.1:8000
NEXT_PUBLIC_WS_URL=ws://localhost:8000/ws/feed

CRON_SECRET=
MAX_UPLOAD_MB=5
